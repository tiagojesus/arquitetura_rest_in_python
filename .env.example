# Aplicação
APP_NAME=Arquitetura REST
DEBUG=false

# Banco de dados
POSTGRES_USER=app
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=appdb

# URL completa (usada apenas fora do docker-compose; dentro dele é montada
# a partir das variáveis POSTGRES_*)
DATABASE_URL=postgresql+psycopg://app:troque-esta-senha@localhost:5432/appdb
