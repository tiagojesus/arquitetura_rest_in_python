# Aplicação
APP_NAME=Arquitetura REST
DEBUG=false

# Banco de dados
POSTGRES_USER=app
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=appdb

# URL completa (usada apenas fora do docker-compose; dentro dele é montada
# a partir das variáveis POSTGRES_*)
DATABASE_URL=postgresql+psycopg://app:troque-esta-senha@localhost:5432/appdb

# Segurança JWT (em produção, gerar uma chave forte única)
SECRET_KEY=super-secret-dev-key-change-immediately
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Documentação Swagger (false em produção)
DOCS_ENABLED=true

# Seed do usuário administrador (trocar a senha em produção)
ADMIN_EMAIL=admin@local.dev
ADMIN_INITIAL_PASSWORD=Admin0.
